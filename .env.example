# Переменные окружения для VK-бота агентства ИИ-Апгрейд.
# Скопируйте этот файл в .env и заполните значения.
# Файл .env не должен попадать в git (.gitignore уже его исключает).

# 1. Токен сообщества ВКонтакте (настройки сообщества → Работа с API → Ключи доступа).
#    Нужен доступ к сообщениям сообщества.
VK_GROUP_TOKEN=

# 2. ID сообщества (число в адресной строке сообщества, например 242427177).
VK_GROUP_ID=

# 3. Ключ API вашей LLM (OpenAI-совместимый сервер или провайдер).
#    Для локального сервера (LM Studio и т.п.) можно оставить пустым.
LLM_API_KEY=

# 4. VK ID менеджера/владельца, который получает уведомления о заявках.
#    Пока пусто — уведомления не отправляются, бот работает без менеджера.
ADMIN_VK_ID=

# 5. Путь к файлу SQLite (создаётся автоматически).
DB_PATH=data/bot.db

# --- Необязательные настройки (по умолчанию берутся из config.yaml) -------
# AI_PROVIDER=local
# LLM_BASE_URL=http://127.0.0.1:1234
# LLM_MODEL_ID=773a7da77e569019bb0fd17a554b263738d669a3
# LOG_LEVEL=INFO
